Options -Indexes
DirectoryIndex index.html
<Files "config.php">
    Require all denied
</Files>
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
    <Files "index.html">
        Header always set Cache-Control "no-store"
    </Files>
</IfModule>
