      "description": "Flat white container for a single administrative task.",
      "html": "<section class=\"ds-panel\"><h2>Peringatan stok menipis</h2><p>Batas yang sama digunakan di ringkasan dan matriks stok.</p></section>",
      "css": ".ds-panel{padding:22px;border:1px solid var(--line,#dfe6ef);border-radius:var(--radius,14px);background:var(--surface,#fff);color:var(--ink,#12233c);font:400 14px/1.5 Inter,Arial,sans-serif}.ds-panel h2{margin:0;font-size:15px;font-weight:600;line-height:1.4;letter-spacing:-.015em}.ds-panel p{margin:5px 0 0;font-size:12px;color:var(--muted,#586b83)}"
    },
