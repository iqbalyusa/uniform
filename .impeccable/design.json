  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Filled blue action; one per task area.",
      "html": "<button class=\"ds-primary\">Catat stok</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:11px 17px;background:var(--accent,#0069aa);color:var(--surface,#fff);border:0;border-radius:var(--control-radius,10px);font:600 .8125rem var(--font-app,'Geist',Arial,sans-serif);cursor:pointer;transition:background-color .18s ease,box-shadow .18s ease,transform .18s ease}.ds-primary:hover{background:var(--accent-hover,#00558a);box-shadow:0 3px 9px #0069aa18}.ds-primary:focus-visible{outline:3px solid var(--focus,#0879b9);outline-offset:3px}.ds-primary:active{transform:translateY(1px)}.ds-primary:disabled{opacity:.5;cursor:not-allowed}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "White bordered action beside or below a primary one.",
      "html": "<button class=\"ds-secondary\">Ekspor Excel</button>",
      "css": ".ds-secondary{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:11px 17px;background:var(--surface,#fff);color:var(--ink,#12233c);border:1px solid var(--line,#e0e7ef);border-radius:var(--control-radius,10px);font:500 .8125rem var(--font-app,'Geist',Arial,sans-serif);cursor:pointer;transition:background-color .18s ease,border-color .18s ease,transform .18s ease}.ds-secondary:hover{background:var(--surface-soft,#f1f5f9);border-color:var(--muted,#586b83)}.ds-secondary:focus-visible{outline:3px solid var(--focus,#0879b9);outline-offset:3px}.ds-secondary:active{transform:translateY(1px)}.ds-secondary:disabled{opacity:.5;cursor:not-allowed}"
    },
    {
      "name": "Text Action",
      "kind": "button",
      "refersTo": "text-action",
      "description": "Blue link-style action that leads somewhere, never a filled button.",
      "html": "<button class=\"ds-text-action\">Data stok <svg aria-hidden=\"true\" width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></button>",
      "css": ".ds-text-action{display:inline-flex;align-items:center;gap:8px;background:transparent;color:var(--accent,#0069aa);border:0;padding:5px 0;font:600 .8125rem var(--font-app,'Geist',Arial,sans-serif);cursor:pointer}.ds-text-action:hover{text-decoration:underline;text-underline-offset:4px}.ds-text-action:focus-visible{outline:3px solid var(--focus,#0879b9);outline-offset:3px}"
    },
    {
      "name": "Search Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Inline-icon search with a focus-within ring.",
      "html": "<label class=\"ds-search\"><svg aria-hidden=\"true\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg><input type=\"search\" aria-label=\"Cari nama seragam\" placeholder=\"Cari nama seragam…\"/></label>",
      "css": ".ds-search{display:flex;align-items:center;gap:10px;min-height:48px;max-width:430px;padding:0 11px;background:var(--surface,#fff);color:var(--muted,#586b83);border:1px solid var(--line,#e0e7ef);border-radius:var(--control-radius,10px)}.ds-search input{width:100%;min-width:0;border:0;outline:none;background:transparent;color:var(--ink,#12233c);padding:12px 0;font:400 .875rem var(--font-app,'Geist',Arial,sans-serif);caret-color:var(--accent,#0069aa)}.ds-search input::placeholder{color:var(--muted,#586b83)}.ds-search:focus-within{outline:3px solid var(--focus,#0879b9);outline-offset:3px}"
    },
    {
      "name": "Navigation Destination",
      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "Active rail destination: pale blue, blue text, weight 600, no marker dot.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Navigasi utama\"><button aria-current=\"page\"><svg aria-hidden=\"true\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/></svg>Data stok</button></nav>",
      "css": ".ds-nav{max-width:212px;background:var(--rail,#fff)}.ds-nav button{display:flex;align-items:center;gap:12px;width:100%;min-height:48px;padding:13px 14px;text-align:left;background:var(--accent-soft,#eaf5fd);color:var(--accent,#0069aa);border:0;border-radius:10px;font:600 .8125rem var(--font-app,'Geist',Arial,sans-serif);line-height:1.4;cursor:pointer}.ds-nav button:hover{background:var(--surface-soft,#f1f5f9)}.ds-nav button:focus-visible{outline:3px solid var(--focus,#0879b9);outline-offset:3px}"
    },
    {
      "name": "Valid Status",
      "kind": "chip",
      "refersTo": "status-valid",
      "description": "Tag with an explicit word; colour never stands alone.",
      "html": "<span class=\"ds-status\">Valid</span>",
      "css": ".ds-status{display:inline-flex;align-items:center;padding:4px 7px;border-radius:6px;background:var(--accent-soft,#eaf5fd);color:var(--accent,#0069aa);font:500 .6875rem var(--font-app,'Geist',Arial,sans-serif);white-space:nowrap}"
    },
    {
      "name": "Working Panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "White bordered surface with a hairline ambient shadow.",
      "html": "<section class=\"ds-panel\"><h2>Peringatan stok menipis</h2><p>Batas yang sama digunakan di ringkasan dan matriks stok.</p></section>",
      "css": ".ds-panel{padding:22px;border:1px solid var(--line,#e0e7ef);border-radius:var(--radius,16px);background:var(--surface,#fff);color:var(--ink,#12233c);box-shadow:0 2px 8px #12233c04;font:400 .875rem/1.55 var(--font-app,'Geist',Arial,sans-serif)}.ds-panel h2{margin:0;font-size:1.125rem;font-weight:600;line-height:1.4;letter-spacing:-.02em}.ds-panel p{margin:6px 0 0;font-size:.8125rem;line-height:1.6;color:var(--muted,#586b83)}"
    },
    {
      "name": "Selected Size Cell",
      "kind": "custom",
      "refersTo": "stock-cell",
      "description": "Size column highlighted after a size is chosen; quantity plus a unit or state word.",
      "html": "<div class=\"ds-size\"><div class=\"ds-size-header\">9</div><button aria-label=\"Polo Shirt MERAH Panjang, Baru ukuran 9: 12 pcs. Catat perubahan.\"><strong>12</strong><span>pcs</span></button></div>",
      "css": ".ds-size{width:74px;background:var(--accent-soft,#eaf5fd);color:var(--accent,#0069aa);font-family:var(--font-app,'Geist',Arial,sans-serif)}.ds-size-header{padding:8px 0;text-align:center;border-block:1px solid var(--line,#e0e7ef);font-size:.75rem;font-weight:500}.ds-size button{display:flex;flex-direction:column;align-items:center;justify-content:center;width:100%;height:64px;padding:8px 2px;border:0;background:transparent;color:inherit;cursor:pointer}.ds-size strong{font-size:1rem;font-weight:600;font-variant-numeric:tabular-nums}.ds-size span{font-size:.6875rem;margin-top:3px;color:var(--muted,#586b83)}.ds-size button:hover{background:var(--accent-soft,#eaf5fd)}.ds-size button:focus-visible{outline:3px solid var(--focus,#0879b9);outline-offset:3px}"
    },
    {
      "name": "Low Stock Cell",
      "kind": "custom",
      "refersTo": "stock-cell",
      "description": "A cell below the limit: pale red surface, red quantity and the word Menipis.",
      "html": "<div class=\"ds-low\"><button aria-label=\"Rok SD, ukuran 11-12: 2 pcs, menipis\"><strong>2</strong><span>Menipis</span></button></div>",
      "css": ".ds-low{width:74px;font-family:var(--font-app,'Geist',Arial,sans-serif)}.ds-low button{display:flex;flex-direction:column;align-items:center;justify-content:center;width:100%;height:64px;padding:8px 2px;border:0;background:var(--red-soft,#fff0ed);color:var(--red,#a63c34);cursor:pointer}.ds-low strong{font-size:1rem;font-weight:600;font-variant-numeric:tabular-nums}.ds-low span{font-size:.6875rem;margin-top:3px}.ds-low button:hover{background:var(--accent-soft,#eaf5fd);color:var(--accent,#0069aa)}.ds-low button:focus-visible{outline:3px solid var(--focus,#0879b9);outline-offset:3px}"
    },
    {
      "name": "File Selection",
      "kind": "custom",
      "refersTo": "upload-area",
      "description": "Dashed upload area with a full-area native file input beneath a blue choice control.",
      "html": "<label class=\"ds-upload\"><svg aria-hidden=\"true\" width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4m14-7-5-5-5 5m5-5v12\"/></svg><strong>Pilih berkas stok</strong><span>Excel .xlsx, CSV, atau JSON · maksimal 5 MB</span><span class=\"ds-upload-choice\" aria-hidden=\"true\">Pilih berkas</span><input type=\"file\" aria-label=\"Pilih berkas stok\" accept=\".xlsx,.csv,.json\"/></label>",
      "css": ".ds-upload{position:relative;display:flex;flex-direction:column;align-items:center;gap:11px;padding:28px 18px;border:1px dashed var(--line,#dfe6ef);border-radius:9px;background:var(--surface-soft,#f4f7fc);color:var(--accent,#0069aa);font-family:var(--font-app,'Geist',Arial,sans-serif);cursor:pointer}.ds-upload strong{font-size:.8125rem;max-width:100%;overflow-wrap:anywhere;text-align:center}.ds-upload>span{font-size:.6875rem;color:var(--muted,#586b83)}.ds-upload input{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:pointer}.ds-upload .ds-upload-choice{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:10px 17px;background:var(--accent,#0069aa);color:var(--surface,#fff);border-radius:var(--control-radius,8px);font-weight:600;font-size:12px}.ds-upload:hover .ds-upload-choice{background:var(--accent-hover,#00558a)}.ds-upload:focus-within{outline:3px solid var(--focus,#0879b9)}.ds-upload.ds-busy{opacity:.65;cursor:wait}.ds-upload.ds-busy input{cursor:wait}"
    }
  ],
  "narrative": {
    "northStar": "The School Stock Workspace",
    "overview": "Pribadi’s school identity gives daily stock administration a clear, coherent home. White navigation and working surfaces carry navy text, while blue identifies actions, selected sizes, and active destinations. The official school logo sits directly on the sidebar with no colored box; retain its original red detail and proportions.\n\nThe workspace is compact and operational. Tables, direct Indonesian labels, visible quantities, and quick entry take priority. School identity comes from the palette, typography, and logo rather than decorative illustrations. The same language carries through stock lookup, movement, history, imports, settings, and the optional navy dark theme. Temporary shared mode hides application sign-in and officer management; the rail omits technical connection and shared-mode labels. Preserved account screens remain available when account enforcement is restored.",
    "keyCharacteristics": [
      "White working surfaces and navy hierarchy",
      "Blue actions, selection, and focus",
      "Self-hosted Geist and tabular quantities",
      "Horizontal size matrices and exact-cell movement handoff",
      "Name and total kept visible on mobile",
      "44px touch targets, and a navigation rail that scrolls on short screens"
    ],
    "rules": [
      {
        "name": "The School Identity Rule",
        "body": "Use the school blue and navy roles consistently across every screen and exported interface; preserve the official logo artwork.",
        "section": "colors"
      },
      {
        "name": "The Legible Action Rule",
        "body": "Use Action Blue for text and filled actions. School Blue is an identity accent, not a substitute for the darker action color.",
        "section": "colors"
      },
      {
        "name": "The Quantity Rule",
        "body": "Show the complete quantity, its size-system context, and a readable unit or state. Do not truncate numeric data to make a table fit.",
        "section": "typography"
      },
      {
        "name": "The Flat Workspace Rule",
        "body": "Give stock data a stable plane; reserve floating depth for transient feedback and navigation overlays.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the official Pribadi logo and use white, navy, and school blue across all screens.",
      "Do use Action Blue for legible actions and School Blue for identity accents.",
      "Do keep quantities complete, aligned with tabular figures, and paired with size context.",
      "Do preserve selected-size centering and exact-cell movement handoff.",
      "Do keep uniform names and totals visible on mobile.",
      "Do pair stock and validation colors with explicit Indonesian labels.",
      "Do respect dark-theme role mapping and reduced-motion preference.",
      "Do give every piece of text a role from the type scale, and keep touch targets at 44px."
    ],
    "donts": [
      "Don't introduce an unrelated brand palette or recolor the official logo.",
      "Don't replace horizontal size matrices with disconnected cards.",
      "Don't hide or truncate quantities or the mobile overview total.",
      "Don't combine old and new size identity in a stock cell.",
      "Don't add heavy shadows to ordinary working panels.",
      "Don't use color alone to indicate low stock, empty stock, or validation.",
      "Don't set text below 11px or outside the type scale, or shrink controls on small screens.",
      "Don't let a short screen hide navigation: the rail scrolls instead.",
      "Don't use `content-visibility` on size matrices; selected-size centering needs every scroller measured."
    ]
  }
}
