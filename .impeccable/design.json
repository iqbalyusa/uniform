  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Save or begin the principal task.",
      "html": "<button class=\"ds-primary\">Catat stok</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:11px 17px;background:var(--accent,#0069aa);color:var(--surface,#fff);border:0;border-radius:var(--control-radius,8px);font:600 12px Inter,Arial,sans-serif;cursor:pointer}.ds-primary:hover{background:var(--accent-hover,#00558a)}.ds-primary:focus-visible{outline:3px solid var(--focus,#0879b9);outline-offset:3px}.ds-primary:active{transform:translateY(1px)}.ds-primary:disabled{opacity:.5;cursor:not-allowed}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "A supporting action within the same workflow.",
      "html": "<button class=\"ds-secondary\">Ekspor Excel</button>",
      "css": ".ds-secondary{display:inline-flex;align-items:center;justify-content:center;min-height:40px;padding:9px 13px;background:var(--surface,#fff);color:var(--ink,#12233c);border:1px solid var(--line,#dfe6ef);border-radius:var(--control-radius,8px);font:500 12px Inter,Arial,sans-serif;cursor:pointer}.ds-secondary:hover{background:var(--surface-soft,#f4f7fc);border-color:var(--muted,#586b83)}.ds-secondary:focus-visible{outline:3px solid var(--focus,#0879b9);outline-offset:3px}.ds-secondary:active{transform:translateY(1px)}.ds-secondary:disabled{opacity:.5;cursor:not-allowed}"
    },
    {
      "name": "Text Action",
      "kind": "button",
      "refersTo": "text-action",
      "description": "A compact route to supporting stock detail.",
      "html": "<button class=\"ds-text-action\">Data stok <svg aria-hidden=\"true\" width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></button>",
      "css": ".ds-text-action{display:inline-flex;align-items:center;gap:8px;background:transparent;color:var(--accent,#0069aa);border:0;padding:5px 0;font:600 12px Inter,Arial,sans-serif;cursor:pointer}.ds-text-action:hover{text-decoration:underline;text-underline-offset:4px}.ds-text-action:focus-visible{outline:3px solid var(--focus,#0879b9);outline-offset:3px}"
    },
    {
      "name": "Search Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Search by uniform name before selecting a size.",
      "html": "<label class=\"ds-search\"><svg aria-hidden=\"true\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg><input type=\"search\" aria-label=\"Cari nama seragam\" placeholder=\"Cari nama seragam…\"/></label>",
      "css": ".ds-search{display:flex;align-items:center;gap:10px;min-height:42px;max-width:430px;padding:0 11px;background:var(--surface,#fff);color:var(--muted,#586b83);border:1px solid var(--line,#dfe6ef);border-radius:var(--control-radius,8px)}.ds-search input{width:100%;min-width:0;border:0;outline:none;background:transparent;color:var(--ink,#12233c);padding:9px 0;font:400 12px Inter,Arial,sans-serif;caret-color:var(--accent,#0069aa)}.ds-search input::placeholder{color:var(--muted,#586b83)}.ds-search:focus-within{outline:2px solid var(--focus,#0879b9);outline-offset:1px}"
    },
    {
      "name": "Navigation Destination",
      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "Active destination in the white rail or mobile drawer.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Navigasi utama\"><button aria-current=\"page\"><svg aria-hidden=\"true\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/></svg>Data stok<span class=\"ds-nav-marker\"></span></button></nav>",
      "css": ".ds-nav{max-width:208px;background:var(--surface,#fff)}.ds-nav button{display:flex;align-items:center;gap:12px;width:100%;min-height:44px;padding:12px;text-align:left;background:var(--accent-soft,#eaf5fd);color:var(--accent,#0069aa);border:0;border-radius:7px;font:700 12px Inter,Arial,sans-serif;cursor:pointer}.ds-nav button:hover{background:var(--surface-soft,#f4f7fc)}.ds-nav button:focus-visible{outline:3px solid var(--focus,#0879b9);outline-offset:3px}.ds-nav-marker{width:6px;height:6px;margin-left:auto;border-radius:50%;background:var(--accent,#0069aa)}"
